{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "properties": {
    "deployment": {
      "image": {
        "description": "Container Image",
        "properties": {
          "repositoryPrefix": {
            "type": "string"
          },
          "imagePullPolicy": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "repositoryPrefix"
        ]
      },
      "flywayInitContainer": {
        "description": "Flyway init container configuration",
        "type": "object",
        "allOf": [
          {
            "if": {
              "properties": {
                "create": { "const": true }
              }
            },
            "then": {
              "required": ["image"],
              "properties": {
                "image": {
                  "type": "object",
                  "required": ["repositoryPrefix", "repositoryName"],
                  "properties": {
                    "repositoryPrefix": {
                      "type": "string",
                      "minLength": 1
                    },
                    "repositoryName": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "anyOf": [
                    {
                      "required": ["tag"],
                      "properties": {
                        "tag": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    {
                      "required": ["digest"],
                      "properties": {
                        "digest": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        ],
        "properties": {
          "create": {
            "description": "Enable Flyway init container creation",
            "type": "boolean",
            "default": false
          },
          "image": {
            "description": "Flyway init container image configuration",
            "type": "object",
            "properties": {
              "repositoryPrefix": {
                "description": "Flyway official image registry prefix",
                "type": "string",
                "default": "docker.io"
              },
              "repositoryName": {
                "description": "Flyway official image repository name",
                "type": "string",
                "default": "flyway/flyway"
              },
              "tag": {
                "description": "Flyway image tag; ignored when digest is set",
                "type": "string",
                "default": "8.2.3"
              },
              "digest": {
                "description": "If set, overrides tag with the specified digest",
                "type": ["string", "null"]
              },
              "imagePullPolicy": {
                "description": "Image pull policy for the init container; if unset, Kubernetes default applies",
                "type": ["string", "null"]
              }
            }
          },
          "executeFlywayMigrate": {
            "description": "Execute Flyway migrate command to apply migrations to the database",
            "type": "boolean",
            "default": true
          },
          "executeFlywayRepair": {
            "description": "Execute Flyway repair command to recompute applied migrations metadata",
            "type": "boolean",
            "default": false
          },
          "downloadRedshiftDriver": {
            "description": "Enable Flyway to download Redshift JDBC driver",
            "type": "boolean",
            "default": false
          },
          "migrationsConfigmap": {
            "description": "ConfigMap with migrations",
            "type": ["string", "null"]
          },
          "migrationPaths": {
            "description": "Comma-separated paths to migration files or directories",
            "type": ["string", "null"]
          },
          "env": {
            "description": "Environment variables for init container",
            "type": "object",
            "default": {}
          },
          "envFromConfigmaps": {
            "description": "Environment variables sourced from ConfigMaps",
            "type": "object",
            "default": {}
          },
          "envFromSecrets": {
            "description": "Environment variables sourced from Secrets",
            "type": "object",
            "default": {}
          },
          "envFromFieldRef": {
            "description": "Environment variables sourced from pod fieldRef",
            "type": "object",
            "default": {}
          }
        }
      },
      "replicas": {
        "description": "Deployment replicas",
        "type": "integer"
      },
      "resources": {
        "description": "Container Resources consumption",
        "properties": {
          "requests": {
            "properties": {
              "cpu": {
                "type": "string"
              },
              "memory": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "limits": {
            "properties": {
              "cpu": {
                "type": "string"
              },
              "memory": {
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "type": "object",
      "required": [
        "resources",
        "replicas"
      ]
    },
    "techStack": {
      "description": "Technology used to develop the service",
      "type": "string",
      "enum": [ "nodejs", "frontend", "scala"]
    },
    "service": {
      "description": "Service properties",
      "properties": {
        "create": {
          "description": "Enable service creation",
          "type": "boolean",
          "default": false
        },
        "type": {
          "description": "Service Type",
          "type": "string",
          "enum": [ "ClusterIP", "NodePort" ],
          "default": "ClusterIP"
        },

        "containerPort": {
          "$comment": "This property shouldn't have a default value",
          "description": "Port",
          "minimum": 0,
          "type": ["integer", "null"]
        },
        "monitoringPort": {
          "description": "Monitoring Port",
          "minimum": 0,
          "type": "integer",
          "default": 9095
        },
        "managementPort": {
          "description": "Management Port",
          "minimum": 0,
          "type": "integer",
          "default": 8558
        }
      },
      "type": "object",
      "if": {
        "properties": {
          "create": { "const": true }
        }
      },
      "then": {
        "properties": {
          "portName": {
            "$comment": "This property shouldn't have a default value",
            "description": "Port Name",
            "type": ["string"]
          }
        }
      }
    },
    "ingress": {
      "description": "Ingress properties",
      "type": "object",
      "allOf": [
        {
          "comment": "When create:true, type must be a non-null string from the allowed enum.",
          "if": {
            "properties": { "create": { "const": true } }
          },
          "then": {
            "required": ["type"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["alb", "generic"]
              }
            }
          }
        },
        {
          "comment": "When create:true and type==generic, ingressClassName and rules are required and must be non-empty.",
          "if": {
            "properties": {
              "create": { "const": true },
              "type":   { "const": "generic" }
            }
          },
          "then": {
            "required": ["ingressClassName", "rules"],
            "properties": {
              "ingressClassName": {
                "type": "string",
                "minLength": 1
              },
              "rules": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ],
      "properties": {
        "create": {
          "description": "Enable ingress creation",
          "type": "boolean",
          "default": false
        },
        "type": {
          "description": "Ingress type",
          "type": ["string", "null"],
          "enum": ["alb", "generic", null]
        },
        "ingressClassName": {
          "description": "Ingress class name; required when type is generic",
          "type": ["string", "null"]
        },
        "groupName": {
          "description": "ALB ingress group name; used when type is alb",
          "type": "string",
          "default": "interop-be"
        },
        "groupOrder": {
          "description": "ALB ingress group order annotation value; optional, used when type is alb",
          "type": ["integer", "null"]
        },
        "host": {
          "description": "Hostname for the ALB ingress rule; used when type is alb",
          "type": ["string", "null"]
        },
        "applicationPath": {
          "description": "Path prefix for the ALB ingress rule; used when type is alb",
          "type": ["string", "null"]
        },
        "annotations": {
          "description": "Annotations to apply to Ingress resource",
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          }
        },
        "rules": {
          "description": "List of ingress rules; used when type is generic (null/omitted for alb). Each item must have host, path and pathType.",
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "required": ["host", "path", "pathType"],
            "properties": {
              "host": {
                "description": "Host for the ingress rule",
                "type": "string",
                "minLength": 1
              },
              "path": {
                "description": "Path for the ingress rule",
                "type": "string",
                "minLength": 1
              },
              "pathType": {
                "description": "Path type for the ingress rule",
                "type": "string",
                "enum": ["Prefix", "Exact", "ImplementationSpecific"]
              }
            }
          }
        }
      }
    },
    "name": {
      "description": "Service name",
      "type": "string"
    },
    "namespace": {
      "description": "Kubernetes namespace",
      "type": "string"
    },
    "serviceAccount": {
      "description": "ServiceAccount configuration",
      "type": "object",
      "properties": {
        "create": {
          "description": "Enable ServiceAccount creation",
          "type": "boolean",
          "default": true
        },
        "roleArn": {
          "description": "ServiceAccount roleARN for AWS IAM role binding (optional)",
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "externalSecrets": {
      "description": "External Secrets Operator configuration - separate configuration for application container and init container",
      "type": "object",
      "properties": {
        "container": {
          "description": "External Secrets configuration for the main application container",
          "type": "object",
          "properties": {
            "create": {
              "description": "Enable ExternalSecret creation for container",
              "type": "boolean",
              "default": false
            },
            "refreshInterval": {
              "description": "Refresh interval for the secret (e.g., '1h', '30m')",
              "type": "string",
              "default": "0"
            },
            "refreshPolicy": {
              "description": "Refresh policy for the secret",
              "type": "string",
              "enum": ["OnChange", "Interval"],
              "default": "OnChange"
            },
            "secretStoreRef": {
              "description": "Reference to SecretStore or ClusterSecretStore",
              "type": "object",
              "properties": {
                "name": {
                  "description": "Name of the SecretStore",
                  "type": "string"
                },
                "kind": {
                  "description": "Kind of the store",
                  "type": "string",
                  "enum": ["SecretStore", "ClusterSecretStore"],
                  "default": "SecretStore"
                }
              }
            },
            "targetSecret": {
              "description": "Target Kubernetes Secret configuration",
              "type": "object",
              "properties": {
                "name": {
                  "description": "Name of the target secret (defaults to microservice name)",
                  "type": "string"
                },
                "creationPolicy": {
                  "description": "Creation policy for the target secret",
                  "type": "string",
                  "enum": ["Owner", "Orphan", "Merge", "None"],
                  "default": "Merge"
                },
                "deletionPolicy": {
                  "description": "Deletion policy for the target secret",
                  "type": "string",
                  "enum": ["Retain", "Delete"],
                  "default": "Retain"
                }
              }
            },
            "data": {
              "description": "List of individual secret keys to sync from external secret manager for the container",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "secretKey": {
                    "description": "Key name in the target Kubernetes Secret",
                    "type": "string"
                  },
                  "remoteRef": {
                    "description": "Reference to the remote secret",
                    "type": "object",
                    "properties": {
                      "key": {
                        "description": "Remote secret key/path",
                        "type": "string"
                      },
                      "property": {
                        "description": "Property to extract from the remote secret",
                        "type": "string"
                      },
                      "version": {
                        "description": "Version identifier for the remote secret",
                        "type": "string"
                      },
                      "conversionStrategy": {
                        "description": "Conversion strategy",
                        "type": "string"
                      },
                      "decodingStrategy": {
                        "description": "Decoding strategy",
                        "type": "string"
                      }
                    },
                    "required": ["key", "property"],
                    "additionalProperties": false
                  }
                },
                "required": ["secretKey", "remoteRef"],
                "additionalProperties": false
              },
              "default": []
            }
          }
        },
        "initContainer": {
          "description": "External Secrets configuration for the init container (e.g., Flyway)",
          "type": "object",
          "properties": {
            "create": {
              "description": "Enable ExternalSecret creation for init container",
              "type": "boolean",
              "default": false
            },
            "refreshInterval": {
              "description": "Refresh interval for the secret (e.g., '1h', '30m')",
              "type": "string",
              "default": "0"
            },
            "refreshPolicy": {
              "description": "Refresh policy for the secret",
              "type": "string",
              "enum": ["OnChange", "Interval"],
              "default": "OnChange"
            },
            "secretStoreRef": {
              "description": "Reference to SecretStore or ClusterSecretStore",
              "type": "object",
              "properties": {
                "name": {
                  "description": "Name of the SecretStore",
                  "type": "string"
                },
                "kind": {
                  "description": "Kind of the store",
                  "type": "string",
                  "enum": ["SecretStore", "ClusterSecretStore"],
                  "default": "SecretStore"
                }
              }
            },
            "targetSecret": {
              "description": "Target Kubernetes Secret configuration",
              "type": "object",
              "properties": {
                "name": {
                  "description": "Name of the target secret (defaults to microservice name with -flyway suffix)",
                  "type": "string"
                },
                "creationPolicy": {
                  "description": "Creation policy for the target secret",
                  "type": "string",
                  "enum": ["Owner", "Orphan", "Merge", "None"],
                  "default": "Merge"
                },
                "deletionPolicy": {
                  "description": "Deletion policy for the target secret",
                  "type": "string",
                  "enum": ["Retain", "Delete"],
                  "default": "Retain"
                }
              }
            },
            "data": {
              "description": "List of individual secret keys to sync from external secret manager for the init container",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "secretKey": {
                    "description": "Key name in the target Kubernetes Secret",
                    "type": "string"
                  },
                  "remoteRef": {
                    "description": "Reference to the remote secret",
                    "type": "object",
                    "properties": {
                      "key": {
                        "description": "Remote secret key/path",
                        "type": "string"
                      },
                      "property": {
                        "description": "Property to extract from the remote secret",
                        "type": "string"
                      },
                      "version": {
                        "description": "Version identifier for the remote secret",
                        "type": "string"
                      },
                      "conversionStrategy": {
                        "description": "Conversion strategy",
                        "type": "string"
                      },
                      "decodingStrategy": {
                        "description": "Decoding strategy",
                        "type": "string"
                      }
                    },
                    "required": ["key", "property"],
                    "additionalProperties": false
                  }
                },
                "required": ["secretKey", "remoteRef"],
                "additionalProperties": false
              },
              "default": []
            }
          }
        }
      },
      "additionalProperties": false
    },
    "podDisruptionBudget": {
      "description": "Pod Disruption Budget configuration for high availability",
      "type": "object",
      "properties": {
        "create": {
          "description": "Enable PodDisruptionBudget creation",
          "type": "boolean",
          "default": false
        },
        "minAvailable": {
          "description": "Minimum number of pods that must be available. Can be an absolute number or a percentage string (e.g., '30%')",
          "type": ["integer", "string", "null"],
          "minimum": 0
        },
        "maxUnavailable": {
          "description": "Maximum number of pods that can be unavailable. Can be an absolute number or a percentage string (e.g., '10%')",
          "type": ["integer", "string", "null"],
          "minimum": 0
        },
        "unhealthyPodEvictionPolicy": {
          "description": "Policy for evicting unhealthy pods during disruption",
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "comment": "Either minAvailable or maxUnavailable can be set, but not both",
          "not": {
            "required": ["minAvailable", "maxUnavailable"],
            "properties": {
              "minAvailable": { "type": ["integer", "string"] },
              "maxUnavailable": { "type": ["integer", "string"] }
            }
          }
        }
      ]
    }
  },
  "required": [
    "name",
    "namespace",
    "techStack"
  ],
  "title": "Values",
  "type": "object"
}
